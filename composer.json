{
    "name": "lightyagami28/tgbotphp",
    "description": "Production-ready PHP framework for the Telegram Bot API: routing, middleware, conversations, webhooks and long polling",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "LightYagami28",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/LightYagami28/TGbotPHP",
    "keywords": [
        "telegram",
        "bot",
        "telegram-bot",
        "telegram-bot-api",
        "php",
        "webhook",
        "polling",
        "api"
    ],
    "require": {
        "php": ">=8.4",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "TGbotPHP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TGbotPHP\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/tgbot"
    ],
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.1"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "analyze": "@phpstan",
        "check": [
            "@test",
            "@phpstan"
        ]
    }
}
