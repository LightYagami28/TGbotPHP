#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * TGbotPHP CLI Tool
 *
 * Manage Telegram bots with ease
 */

$autoloaders = [
    dirname(__DIR__) . '/vendor/autoload.php',   // running from the repository
    dirname(__DIR__, 3) . '/autoload.php',       // installed as a Composer dependency
];

foreach ($autoloaders as $autoloader) {
    if (is_file($autoloader)) {
        require_once $autoloader;
        break;
    }
}

use TGbotPHP\CLI\Console;

exit((new Console())->run($argv));
