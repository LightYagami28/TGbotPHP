# Copy to .env (never commit it) or export these in the process environment.
# The library does not read .env by itself: use your process manager, Docker or `export`.

# Required: bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Required for webhooks: 1-256 characters A-Z a-z 0-9 _ -  (openssl rand -hex 32)
TELEGRAM_SECRET_TOKEN=

# Optional: bot username without @, used to match /command@bot in groups
TELEGRAM_BOT_USERNAME=

# Optional: used only by the wiki "Examples" page
OWNER_CHAT_ID=
